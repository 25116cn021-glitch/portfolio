<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sahil Yadav — Portfolio</title>
<style>
:root {
  --bg: #050505;
  --fg: #f2f2f2;
  --muted: #858585;
  --line: #242424;
  --card: #0d0d0d;
  --green: #b7ff4a;
  --ease: cubic-bezier(.16,1,.3,1);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  overflow-x: hidden;
  cursor: none;
}
body.loading { overflow: hidden; }
a { color: inherit; text-decoration: none; }
.wrap { width: min(1180px, 90%); margin: auto; }

/* Background patterns & radial glow */
body:before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  pointer-events: none;
  background-image: 
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 70px 70px;
  -webkit-mask-image: linear-gradient(to bottom, #000, transparent 75%);
  mask-image: linear-gradient(to bottom, #000, transparent 75%);
  animation: gridDrift 18s linear infinite;
}
body:after {
  content: "";
  position: fixed;
  width: 420px;
  height: 420px;
  left: var(--mx, 50%);
  top: var(--my, 30%);
  transform: translate(-50%, -50%);
  border-radius: 50%;
  pointer-events: none;
  z-index: -2;
  background: radial-gradient(circle, rgba(183,255,74,.09), transparent 68%);
  transition: left .25s ease-out, top .25s ease-out;
}

@keyframes gridDrift { to { background-position: 0 70px; } }
@keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
@keyframes lineIn { to { transform: scaleX(1); } }
@keyframes orb { 50% { transform: translate(-30px, 25px) scale(1.15); } }
@keyframes pulseLine { 50% { width: 70px; opacity: .5; } }
@keyframes chIn { to { opacity: 1; transform: none; filter: none; } }
@keyframes sway { 0%,100% { rotate: 0deg; translate: 0 0; } 25% { rotate: -1.2deg; translate: 0 -6px; } 75% { rotate: 1.2deg; translate: 0 -6px; } }

/* Custom Cursor */
.cursor {
  position: fixed;
  width: 10px;
  height: 10px;
  border: 1px solid var(--green);
  border-radius: 50%;
  z-index: 100;
  pointer-events: none;
  transform: translate(-50%, -50%);
  transition: width .2s, height .2s, background .2s;
}
.cursor-ring {
  position: fixed;
  width: 36px;
  height: 36px;
  border: 1px solid rgba(183,255,74,.35);
  border-radius: 50%;
  z-index: 99;
  pointer-events: none;
  transform: translate(-50%, -50%);
  transition: width .25s, height .25s, left .12s ease-out, top .12s ease-out;
}
.cursor.active { width: 18px; height: 18px; background: rgba(183,255,74,.15); }
.cursor-ring.active { width: 58px; height: 58px; }

/* Preloader & Scroll Progress */
.preloader {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: #050505;
  display: flex;
  align-items: center;
  justify-content: center;
  clip-path: inset(0);
  transition: clip-path 1.1s cubic-bezier(.76,0,.24,1);
}
.preloader.done { clip-path: inset(0 0 100% 0); pointer-events: none; }
.pl-inner { width: min(320px, 70vw); }
.pl-top { display: flex; justify-content: space-between; align-items: baseline; animation: fadeUp .8s both; }
.pl-name { font-size: 22px; font-weight: 800; letter-spacing: -1px; }
.pl-name span { color: var(--green); }
.pl-count { font: 12px monospace; letter-spacing: 3px; color: var(--muted); }
.pl-bar { height: 1px; background: var(--line); margin-top: 18px; overflow: hidden; }
.pl-bar i { display: block; height: 100%; background: var(--green); transform: scaleX(0); transform-origin: left; }
.progress {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 2px;
  z-index: 30;
  background: var(--green);
  transform: scaleX(0);
  transform-origin: left;
  box-shadow: 0 0 12px rgba(183,255,74,.6);
  pointer-events: none;
}

/* Navigation */
nav {
  position: fixed;
  z-index: 20;
  top: 0; left: 0; right: 0;
  background: rgba(5,5,5,.78);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
  transition: background .4s;
}
nav.scrolled { background: rgba(5,5,5,.92); }
.nav { height: 72px; display: flex; align-items: center; justify-content: space-between; transition: height .4s var(--ease); }
nav.scrolled .nav { height: 60px; }
.brand { font-size: 20px; font-weight: 800; letter-spacing: -1px; }
.brand span { color: var(--green); }
.navlinks { display: flex; gap: 30px; font-size: 13px; color: #aaa; }
.navlinks a { position: relative; transition: color .3s; }
.navlinks a:hover, .navlinks a.active { color: #fff; }
.navlinks a:after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: -6px;
  height: 1px;
  background: var(--green);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform .4s var(--ease);
}
.navlinks a:hover:after, .navlinks a.active:after { transform: scaleX(1); transform-origin: left; }
.mag { display: inline-block; transition: translate .35s var(--ease), color .3s, border-color .3s; }

/* Hero Section */
.hero {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 110px 0 70px;
  border-bottom: 1px solid var(--line);
}
.net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
.hero .wrap { position: relative; z-index: 1; will-change: transform, opacity; }
.hero:before {
  content: "";
  position: absolute;
  left: 0; top: 72px;
  width: 100%; height: 1px;
  background: linear-gradient(90deg, transparent, var(--green), transparent);
  transform: scaleX(0);
  animation: lineIn 1.5s .4s forwards;
}
.hero:after {
  content: "";
  position: absolute;
  width: 180px; height: 180px;
  border: 1px solid rgba(183,255,74,.12);
  border-radius: 50%;
  right: 12%; top: 20%;
  animation: orb 8s ease-in-out infinite;
}
body.loading .hero *, body.loading .hero:before { animation-play-state: paused; }
.kicker {
  position: relative;
  font: 11px monospace;
  letter-spacing: 3px;
  color: var(--green);
  margin-bottom: 22px;
  text-transform: uppercase;
  animation: fadeUp .8s .1s both;
}
.kicker:after {
  content: "";
  display: inline-block;
  width: 42px; height: 1px;
  background: var(--green);
  vertical-align: middle;
  margin-left: 12px;
  animation: pulseLine 2s infinite;
}
h1 { font-size: clamp(60px, 10vw, 145px); line-height: .82; letter-spacing: -8px; max-width: 1000px; }
h1 span { display: block; color: #777; }
.ch {
  display: inline-block;
  font-style: normal;
  opacity: 0;
  transform: translateY(60%) rotate(4deg);
  filter: blur(10px);
  animation: chIn 1.1s var(--ease) forwards;
  animation-delay: calc(var(--i) * 55ms + .1s);
}
.intro { max-width: 650px; margin-top: 40px; font-size: 20px; line-height: 1.5; color: #aaa; animation: fadeUp .9s .45s both; }
.meta { display: grid; grid-template-columns: repeat(2, 180px); gap: 35px; margin-top: 55px; animation: fadeUp .9s .65s both; }
.meta small { display: block; color: #555; font: 10px monospace; letter-spacing: 2px; margin-bottom: 8px; }
.meta b { font-size: 15px; }
.scroll { position: absolute; right: 5%; bottom: 35px; color: #555; font: 10px monospace; letter-spacing: 2px; writing-mode: vertical-rl; }

/* Sections */
section { padding: 120px 0; border-bottom: 1px solid var(--line); }
.section-head { position: relative; display: flex; justify-content: space-between; gap: 40px; margin-bottom: 65px; }
.section-head:after {
  content: "";
  position: absolute;
  left: 0; bottom: -30px;
  width: 100%; height: 1px;
  background: linear-gradient(90deg, var(--green), rgba(183,255,74,.15) 30%, transparent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 1.4s .25s var(--ease);
}
.section-head.in:after { transform: scaleX(1); }
.eyebrow { font: 11px monospace; color: var(--green); letter-spacing: 3px; }
.section-head h2 { font-size: clamp(45px, 7vw, 90px); letter-spacing: -5px; line-height: .9; max-width: 700px; }
.about { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
.bigtext { font-size: 31px; line-height: 1.25; }
.muted { color: #777; }
.about p { color: #999; font-size: 16px; line-height: 1.8; }
html .stg { opacity: 0; translate: 0 42px; transition: opacity 1s var(--ease) var(--d, 0s), translate 1s var(--ease) var(--d, 0s); }
html .stg.in { opacity: 1; translate: 0 0; }

/* Certificates */
.certs { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
.cert { margin: 0; transform-origin: 0 50%; transition: opacity 1.2s var(--ease), translate 1.2s var(--ease), transform 1.6s var(--ease); }
.cert:nth-child(2) { transform-origin: 100% 50%; }
.cert.pre { opacity: 0; transform: perspective(1100px) rotateY(-75deg) rotateZ(-8deg) scale(.85); translate: 0 40px; }
.cert.pre:nth-child(2) { transform: perspective(1100px) rotateY(75deg) rotateZ(8deg) scale(.85); }
.cert.pre.in, .cert.pre.in:nth-child(2) { opacity: 1; transform: perspective(1100px) rotateY(0deg) rotateZ(0deg) scale(1); translate: 0 0; }
.cert.in { animation: sway 8s ease-in-out 2s infinite; }
.cert:hover { animation-play-state: paused; }
.cframe {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  background: #111;
  transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  transition: transform .5s var(--ease), border-color .4s, box-shadow .4s;
  cursor: pointer;
}
.cert:hover .cframe { border-color: rgba(183,255,74,.55); box-shadow: 0 30px 80px rgba(183,255,74,.08); }
.cframe img { display: block; width: 100%; height: auto; transition: transform 1s var(--ease); }
.cert:hover .cframe img { transform: scale(1.04); }
.cframe:before {
  content: "";
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 2px;
  background: var(--green);
  box-shadow: 0 0 18px var(--green);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
}
.cert:hover .cframe:before { animation: scan 1.4s var(--ease); }
@keyframes scan { 0% { top: 0; opacity: 1; } 100% { top: 100%; opacity: 0; } }
.zoom {
  position: absolute;
  top: 14px; right: 14px;
  z-index: 3;
  font: 10px monospace;
  letter-spacing: 2px;
  font-style: normal;
  color: var(--fg);
  background: rgba(5,5,5,.8);
  padding: 6px 9px;
  border: 1px solid var(--line);
  opacity: 0;
  transform: translateY(-6px);
  transition: opacity .4s, transform .5s var(--ease);
}
.cert:hover .zoom { opacity: 1; transform: none; }
.cert figcaption { padding-top: 20px; }
.cert .num { font: 11px monospace; color: var(--green); }
.cert h3 { font-size: 21px; margin: 10px 0 8px; line-height: 1.25; transition: color .3s; }
.cert:hover h3 { color: var(--green); }
.cert p { color: #777; font-size: 14px; line-height: 1.6; }
.verify {
  display: inline-block;
  margin-top: 14px;
  font: 11px monospace;
  letter-spacing: 2px;
  color: var(--green);
  border-bottom: 1px solid rgba(183,255,74,.4);
  padding-bottom: 4px;
}
.verify:hover { border-color: var(--green); }

/* Contact */
.contact { min-height: 70vh; display: flex; flex-direction: column; justify-content: center; border-bottom: 0; }
.contact h2 { font-size: clamp(55px, 9vw, 120px); letter-spacing: -7px; line-height: .85; margin-top: 20px; }
.contact h2 span { color: var(--green); }
.contact p { margin-top: 28px; color: #888; max-width: 520px; line-height: 1.7; }
.gh { display: inline-flex; align-items: center; gap: 14px; margin-top: 45px; font-size: 20px; border-bottom: 1px solid #555; padding-bottom: 10px; }
.gh svg { width: 26px; height: 26px; fill: currentColor; }
.gh:hover { color: var(--green); border-color: var(--green); }
footer { padding: 35px 0; color: #555; font: 11px monospace; display: flex; justify-content: space-between; border-top: 1px solid var(--line); }

/* Lightbox */
.lb {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(5,5,5,.94);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .5s;
}
.lb.open { opacity: 1; pointer-events: auto; }
.lb img {
  max-height: 84vh;
  max-width: 88vw;
  box-shadow: 0 40px 120px rgba(0,0,0,.7);
  opacity: 0;
  transform: scale(.92) translateY(20px);
  transition: transform .8s var(--ease), opacity .5s;
}
.lb img.in { opacity: 1; transform: none; }
.lb-x { position: absolute; top: 24px; right: 28px; font: 11px monospace; letter-spacing: 3px; color: #aaa; cursor: pointer; }
.lb-x:hover { color: var(--green); }
.lb button {
  position: absolute;
  top: 50%;
  translate: 0 -50%;
  background: none;
  border: 1px solid var(--line);
  color: #aaa;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  font-size: 26px;
  line-height: 1;
  transition: color .3s, border-color .3s;
  cursor: pointer;
}
.lb button:hover { color: var(--green); border-color: var(--green); }
.lb-prev { left: 3vw; }
.lb-next { right: 3vw; }

@media(hover:none) {
  body { cursor: auto; }
  .cursor, .cursor-ring { display: none; }
  .zoom { opacity: 1; transform: none; }
}
@media(max-width: 750px) {
  .navlinks { display: none; }
  h1 { letter-spacing: -5px; }
  .about, .certs { grid-template-columns: 1fr; }
  .section-head { display: block; }
  .section-head h2 { margin-top: 20px; }
  .meta { grid-template-columns: 1fr 1fr; }
  .hero { min-height: 90vh; }
  .about { gap: 30px; }
  .bigtext { font-size: 26px; }
  section { padding: 90px 0; }
  .lb-prev { left: 8px; }
  .lb-next { right: 8px; }
  .lb button { width: 40px; height: 40px; }
}
@media(prefers-reduced-motion: reduce) {
  *, *:before, *:after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    transition-delay: 0s !important;
  }
  html .stg { opacity: 1 !important; translate: none !important; }
  .cert.pre { opacity: 1; transform: none; translate: none; }
  .cert.in { animation: none; }
  .ch { opacity: 1; transform: none; filter: none; }
  .net { display: none; }
}
</style>
<noscript>
