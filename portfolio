<script>
(function(){
const $ = (s, c = document) => c.querySelector(s);
const $$ = (s, c = document) => [...c.querySelectorAll(s)];
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
const hasIO = 'IntersectionObserver' in window;

/* Scramble effect */
const GL = '!<>-_\\/[]{}=+*^?#01';
function scramble(el, dur) {
  if (reduce) return;
  const fin = el.textContent, t0 = performance.now();
  (function f(t) {
    const p = Math.min(1, (t - t0) / (dur || 900));
    el.textContent = [...fin].map((c, i) => (c === ' ' || c === '/' || i < p * fin.length) ? c : GL[Math.random() * GL.length | 0]).join('');
    if (p < 1) requestAnimationFrame(f);
    else el.textContent = fin;
  })(t0);
}

/* Split hero text into animated spans */
const h1 = $('.hero h1');
h1.setAttribute('aria-label', 'Sahil Yadav.');
let n = 0;
(function split(node) {
  [...node.childNodes].forEach(ch => {
    if (ch.nodeType === 3) {
      const fr = document.createDocumentFragment();
      [...ch.textContent].forEach(c => {
        const e = document.createElement('em');
        e.className = 'ch';
        e.setAttribute('aria-hidden', 'true');
        e.style.setProperty('--i', n++);
        e.textContent = c;
        fr.appendChild(e);
      });
      ch.replaceWith(fr);
    } else if (ch.nodeType === 1) split(ch);
  });
})(h1);

/* Preloader animation */
const pre = $('.preloader'), cnt = $('.pl-count'), bar = $('.pl-bar i');
function finish() {
  document.body.classList.remove('loading');
  scramble($('.kicker'), 1100);
}
if (reduce) {
  pre.remove();
  document.body.classList.remove('loading');
} else {
  const D = 1400, t0 = performance.now();
  (function tick(t) {
    const p = Math.min(1, (t - t0) / D), e = 1 - Math.pow(1 - p, 3);
    cnt.textContent = String(Math.round(e * 100)).padStart(3, '0');
    bar.style.transform = 'scaleX(' + e + ')';
    if (p < 1) requestAnimationFrame(tick);
    else setTimeout(() => {
      pre.classList.add('done');
      setTimeout(finish, 450);
      setTimeout(() => pre.remove(), 1300);
    }, 200);
  })(t0);
  setTimeout(() => document.body.classList.remove('loading'), 3500);
}

/* Dynamic particle network background */
const cv = $('.net'), ctx = cv.getContext('2d'), hero = $('.hero');
let W = 0, H = 0, pts = [], mouse = {x: -999, y: -999}, run = true;

function size() {
  const r = cv.getBoundingClientRect(), d = Math.min(devicePixelRatio || 1, 2);
  W = r.width; H = r.height;
  cv.width = W * d; cv.height = H * d;
  ctx.setTransform(d, 0, 0, d, 0, 0);
  pts = Array.from({length: Math.min(65, Math.floor(W / 22))}, () => ({
    x: Math.random() * W,
    y: Math.random() * H,
    vx: (Math.random() - .5) * .35,
    vy: (Math.random() - .5) * .35
  }));
}

function draw() {
  ctx.clearRect(0, 0, W, H);
  for (let i = 0; i < pts.length; i++) {
    const p = pts[i];
    if (!reduce) {
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0 || p.x > W) p.vx *= -1;
      if (p.y < 0 || p.y > H) p.vy *= -1;
    }
    ctx.fillStyle = 'rgba(183,255,74,.55)';
    ctx.beginPath();
    ctx.arc(p.x, p.y, 1.4, 0, 6.283);
    ctx.fill();

    for (let j = i + 1; j < pts.length; j++) {
      const q = pts[j], dx = p.x - q.x, dy = p.y - q.y, dd = dx * dx + dy * dy;
      if (dd < 14400) {
        ctx.strokeStyle = 'rgba(183,255,74,' + (.15 * (1 - dd / 14400)) + ')';
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(q.x, q.y);
        ctx.stroke();
      }
    }
    const mx = p.x - mouse.x, my = p.y - mouse.y, md = mx * mx + my * my;
    if (md < 22500) {
      ctx.strokeStyle = 'rgba(183,255,74,' + (.35 * (1 - md / 22500)) + ')';
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(mouse.x, mouse.y);
      ctx.stroke();
    }
  }
  if (run && !reduce) requestAnimationFrame(draw);
}
size(); draw();
addEventListener('resize', () => { size(); if (reduce) draw(); });
hero.addEventListener('mousemove', e => {
  const r = cv.getBoundingClientRect();
  mouse.x = e.clientX - r.left;
  mouse.y = e.clientY - r.top;
});
hero.addEventListener('mouseleave', () => { mouse.x = mouse.y = -999; });
if (hasIO) {
  new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { if (!run) { run = true; draw(); } }
    else run = false;
  })).observe(hero);
}

/* Staggered on-scroll reveals */
const io = hasIO ? new IntersectionObserver(es => es.forEach(e => {
  if (!e.isIntersecting) return;
  e.target.classList.add('in');
  if (e.target.classList.contains('eyebrow')) scramble(e.target, 800);
  io.unobserve(e.target);
}), {threshold: .1, rootMargin: '0px 0px -6% 0px'}) : null;

if (io) {
  [['.section-head > *', 90], ['.about > *', 120], ['.contact .wrap > :not(.gh)', 110]].forEach(([sel, step]) => {
    $$(sel).forEach(el => {
      const sibs = [...el.parentElement.children].filter(x => x.matches(sel));
      el.classList.add('stg');
      el.style.setProperty('--d', (sibs.indexOf(el) * step) + 'ms');
      io.observe(el);
    });
  });
  $$('.section-head').forEach(el => io.observe(el));
}

/* Scroll progress, navbar, & parallax */
const prog = $('.progress'), nav = $('nav'), hw = $('.hero .wrap');
let tk = false;
function onScroll() {
  const y = scrollY, max = document.documentElement.scrollHeight - innerHeight;
  prog.style.transform = 'scaleX(' + (max > 0 ? y / max : 0) + ')';
  nav.classList.toggle('scrolled', y > 40);
  if (!reduce && y < innerHeight * 1.2) {
    hw.style.translate = '0 ' + (y * .22) + 'px';
    hw.style.opacity = Math.max(0, 1 - y / (innerHeight * .85));
  }
  tk = false;
}
addEventListener('scroll', () => { if (!tk) { tk = true; requestAnimationFrame(onScroll); } }, {passive: true});
onScroll();

const links = $$('.navlinks a');
if (hasIO) {
  const spy = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) {
      links.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
    }
  }), {rootMargin: '-45% 0px -50% 0px'});
  ['about', 'certs', 'contact'].forEach(id => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });
}

/* Custom cursor & magnetic buttons */
const cur = $('.cursor'), ring = $('.cursor-ring');
if (fine) {
  document.addEventListener('mousemove', e => {
    cur.style.left = ring.style.left = e.clientX + 'px';
    cur.style.top = ring.style.top = e.clientY + 'px';
    document.body.style.setProperty('--mx', e.clientX + 'px');
    document.body.style.setProperty('--my', e.clientY + 'px');
  });
  $$('a, .cert, .lb button, .lb-x').forEach(el => {
    el.addEventListener('mouseenter', () => { cur.classList.add('active'); ring.classList.add('active'); });
    el.addEventListener('mouseleave', () => { cur.classList.remove('active'); ring.classList.remove('active'); });
  });
}
if (fine && !reduce) {
  $$('.mag').forEach(m => {
    m.addEventListener('mousemove', e => {
      const r = m.getBoundingClientRect();
      m.style.translate = ((e.clientX - r.left - r.width / 2) * .25) + 'px ' + ((e.clientY - r.top - r.height / 2) * .35) + 'px';
    });
    m.addEventListener('mouseleave', () => { m.style.translate = '0 0'; });
  });
}

/* 3D tilt & lightbox modal */
const certs = $$('.cert');
if (hasIO) {
  const cio = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('in');
      cio.unobserve(e.target);
    }
  }), {threshold: .1, rootMargin: '0px 0px -5% 0px'});
  certs.forEach((c, i) => {
    c.classList.add('pre');
    c.style.transitionDelay = (i * 250) + 'ms';
    cio.observe(c);
  });
}
if (fine && !reduce) {
  certs.forEach(c => {
    const f = $('.cframe', c);
    f.addEventListener('mousemove', e => {
      const r = f.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5;
      const y = (e.clientY - r.top) / r.height - .5;
      f.style.setProperty('--ry', (x * 6) + 'deg');
      f.style.setProperty('--rx', (-y * 6) + 'deg');
    });
    f.addEventListener('mouseleave', () => {
      f.style.setProperty('--rx', '0deg');
      f.style.setProperty('--ry', '0deg');
    });
  });
}

const lb = $('.lb'), big = $('img', lb);
let idx = 0;
function fill() {
  big.src = $('img', certs[idx]).src;
  big.alt = $('img', certs[idx]).alt;
}
function open(i) {
  idx = i;
  fill();
  lb.classList.add('open');
  document.body.style.overflow = 'hidden';
  requestAnimationFrame(() => requestAnimationFrame(() => big.classList.add('in')));
}
function close() {
  lb.classList.remove('open');
  big.classList.remove('in');
  document.body.style.overflow = '';
}
function go(d) {
  big.classList.remove('in');
  setTimeout(() => {
    idx = (idx + d + certs.length) % certs.length;
    fill();
    big.classList.add('in');
  }, 220);
}

certs.forEach((c, i) => $('.cframe', c).addEventListener('click', () => open(i)));
$('.lb-prev').addEventListener('click', e => { e.stopPropagation(); go(-1); });
$('.lb-next').addEventListener('click', e => { e.stopPropagation(); go(1); });
$('.lb-x').addEventListener('click', close);
lb.addEventListener('click', e => { if (e.target === lb) close(); });
addEventListener('keydown', e => {
  if (!lb.classList.contains('open')) return;
  if (e.key === 'Escape') close();
  else if (e.key === 'ArrowRight') go(1);
  else if (e.key === 'ArrowLeft') go(-1);
});
})();
</script>
</body>
</html>
